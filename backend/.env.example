PORT=4000
# Must be a replica set (transactions). docker compose / Atlas both work.
MONGO_URL=mongodb://127.0.0.1:27017/feedants?directConnection=true
# Used by `npm test` (the test DB is dropped on every run)
MONGO_URL_TEST=mongodb://127.0.0.1:27017/feedants_test?directConnection=true
JWT_SECRET=change-me
# Exposes /api/auth/demo-users and /api/auth/demo-login. Set false in production.
ALLOW_DEMO_LOGIN=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
PUBLIC_WEB_URL=https://feedants.com
