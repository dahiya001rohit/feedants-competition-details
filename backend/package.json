{
  "name": "feedants-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --env-file-if-exists=.env --test",
    "rush": "node --env-file-if-exists=.env scripts/rush.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
